{
  "name": "@scrollframe/element",
  "version": "0.3.0",
  "description": "Framework-agnostic <scroll-sequence> custom element for scroll storytelling: works in Angular, Vue, Svelte, Astro and plain HTML.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierCornejoLeal/scrollframe.git",
    "directory": "packages/element"
  },
  "homepage": "https://github.com/JavierCornejoLeal/scrollframe#readme",
  "bugs": {
    "url": "https://github.com/JavierCornejoLeal/scrollframe/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/index.global.js",
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/scroll-sequence.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "scroll",
    "scrollytelling",
    "web-component",
    "custom-element",
    "image-sequence"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs"
  },
  "dependencies": {
    "@scrollframe/core": "workspace:^"
  }
}
