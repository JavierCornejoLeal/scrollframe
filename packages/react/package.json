{
  "name": "@scrollframe/react",
  "version": "0.3.0",
  "description": "React / Next.js scroll storytelling component powered by @scrollframe/core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierCornejoLeal/scrollframe.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/JavierCornejoLeal/scrollframe#readme",
  "bugs": {
    "url": "https://github.com/JavierCornejoLeal/scrollframe/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "nextjs",
    "scroll",
    "scrollytelling",
    "image-sequence"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs"
  },
  "dependencies": {
    "@scrollframe/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
