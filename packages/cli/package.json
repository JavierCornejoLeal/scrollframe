{
  "name": "@scrollframe/cli",
  "version": "0.1.0",
  "description": "Turn a video into an optimized, SEO-friendly scroll storytelling sequence with one command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierCornejoLeal/scrollframe.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/JavierCornejoLeal/scrollframe#readme",
  "bugs": {
    "url": "https://github.com/JavierCornejoLeal/scrollframe/issues"
  },
  "type": "module",
  "bin": {
    "scrollframe": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "scroll",
    "scrollytelling",
    "video",
    "frames",
    "webp",
    "cli"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --target node20",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@scrollframe/core": "workspace:^",
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.34.0"
  }
}
