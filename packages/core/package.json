{
  "name": "@scrollframe/core",
  "version": "0.0.0",
  "description": "Framework-agnostic scroll-driven image sequence engine (canvas, lazy loading, Core Web Vitals friendly).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "keywords": ["scroll", "scrollytelling", "image-sequence", "canvas", "storytelling"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p ."
  }
}
